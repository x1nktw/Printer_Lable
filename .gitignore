## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Local / build / publish outputs
artifacts/
publish/
nupkg/
*.nupkg
tools/InnoSetup*/
tools/Inno Setup*/

# Desktop / repo launch shortcuts (created by local publish)
*.lnk

# Accidental release drops copied into the repo root
/*.zip
/*.exe

# Local databases and backups
*.db
*.db-shm
*.db-wal
*.bak

TestResults/
coverage*
coverage/
*.coverage
*.coveragexml

# Secrets / local overrides
appsettings.*.local.json
*.pfx
*.p12
*.key
.env
.env.*

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Local label preview dumps / scratch
/test/

# Rider / ReSharper
_ReSharper*/
*.DotSettings.user
