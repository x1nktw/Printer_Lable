{
  "manifest_version": 3,
  "name": "LabelPrint FrontPad Bridge",
  "version": "1.3.6",
  "description": "Перехватывает сохранение заказа FrontPad (order.php) и отправляет состав в LabelPrint Pro.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "*://*.frontpad.ru/*",
    "*://frontpad.ru/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:8765/*",
    "http://localhost/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LabelPrint FrontPad Bridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.frontpad.ru/*", "*://frontpad.ru/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.frontpad.ru/*", "*://frontpad.ru/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
