<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LabelPrint.Domain\LabelPrint.Domain.csproj" />
    <ProjectReference Include="..\LabelPrint.Plugins.Abstractions\LabelPrint.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\LabelPrint.Application\LabelPrint.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.14" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LabelPrint.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\fonts\*.ttf" LogicalName="LabelPrint.Infrastructure.Printing.Assets.fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\icons\*.png" LogicalName="LabelPrint.Infrastructure.Printing.Assets.icons.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
