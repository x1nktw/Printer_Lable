<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LabelPrint.UI.Controls.PlusMinusNumeric"
             x:Name="Root">
  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
    <Border Width="{Binding #Root.FieldWidth}"
            Height="28"
            BorderBrush="{DynamicResource TextControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Background="{DynamicResource TextControlBackground}"
            ClipToBounds="True">
      <NumericUpDown Value="{Binding #Root.Value}"
                     Minimum="{Binding #Root.Minimum}"
                     Maximum="{Binding #Root.Maximum}"
                     Increment="{Binding #Root.Increment}"
                     FormatString="{Binding #Root.FormatString}"
                     MinHeight="0"
                     Height="26"
                     Padding="6,0"
                     Margin="0"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     ShowButtonSpinner="False"
                     FocusAdorner="{x:Null}" />
    </Border>
    <Button Width="28" Height="28" MinWidth="28" MinHeight="28"
            Padding="0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            FocusAdorner="{x:Null}"
            Click="OnMinusClick"
            ToolTip.Tip="Уменьшить">
      <TextBlock Text="−"
                 FontSize="14"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center" />
    </Button>
    <Button Width="28" Height="28" MinWidth="28" MinHeight="28"
            Padding="0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            FocusAdorner="{x:Null}"
            Click="OnPlusClick"
            ToolTip.Tip="Увеличить">
      <TextBlock Text="+"
                 FontSize="14"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center" />
    </Button>
  </StackPanel>
</UserControl>
