<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabelPrint.UI.ViewModels"
        xmlns:pages="using:LabelPrint.UI.Views.Pages"
        xmlns:dto="using:LabelPrint.Application.DTOs"
        x:Class="LabelPrint.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="LabelPrint Pro"
        Width="1480"
        Height="900"
        MinWidth="1200"
        MinHeight="720">

  <Panel>
    <Grid ColumnDefinitions="240,*" IsEnabled="{Binding IsSignedIn}">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="0,0,1,0"
              Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,20">
            <TextBlock Text="LabelPrint"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <TextBlock Text="Pro"
                       FontSize="13"
                       Opacity="0.65"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <TextBlock Text="{Binding CurrentUserLabel}"
                       Margin="0,12,0,0"
                       Opacity="0.8"
                       TextWrapping="Wrap" />
            <Button Content="Выйти"
                    Command="{Binding SignOutCommand}"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch" />
          </StackPanel>

          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNavItem}"
                   Background="Transparent"
                   BorderThickness="0"
                   Classes="nav">
            <ListBox.Styles>
              <Style Selector="ListBox.nav ListBoxItem">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
              </Style>
              <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
                <Setter Property="CornerRadius" Value="6" />
              </Style>
              <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
                <Setter Property="CornerRadius" Value="6" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource SystemRegionBrush}"
              Padding="24">
        <ContentControl Content="{Binding CurrentPage}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:HomeViewModel">
              <pages:HomePageView />
            </DataTemplate>
            <DataTemplate DataType="vm:CatalogViewModel">
              <pages:CatalogPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:RawMaterialsViewModel">
              <pages:RawMaterialsPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:TemplatesViewModel">
              <pages:TemplatesPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:TemplateEditorViewModel">
              <pages:TemplateEditorPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:SettingsViewModel">
              <pages:SettingsPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:PrintersViewModel">
              <pages:PrintersPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:QueueViewModel">
              <pages:QueuePageView />
            </DataTemplate>
            <DataTemplate DataType="vm:HistoryViewModel">
              <pages:HistoryPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:OrdersViewModel">
              <pages:OrdersPageView />
            </DataTemplate>
            <DataTemplate DataType="vm:PlaceholderViewModel">
              <pages:PlaceholderPageView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Grid>

    <Border IsVisible="{Binding !IsSignedIn}"
            Background="#CC101010"
            ZIndex="100">
      <Border Width="420"
              Padding="28"
              CornerRadius="12"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <StackPanel Spacing="12">
          <TextBlock Text="LabelPrint Pro" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="Выберите пользователя смены" Opacity="0.75" HorizontalAlignment="Center" />
          <ListBox ItemsSource="{Binding Users}"
                   SelectedItem="{Binding SelectedLoginUser}"
                   MaxHeight="180">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:UserListItemDto">
                <TextBlock>
                  <Run Text="{Binding Name}" />
                  <Run Text=" — " />
                  <Run Text="{Binding Role}" />
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox Watermark="PIN (если задан)"
                   Text="{Binding LoginPin}"
                   PasswordChar="•" />
          <TextBlock Text="{Binding LoginError}" Foreground="#E57373" TextWrapping="Wrap" />
          <Button Content="Войти"
                  Command="{Binding SignInCommand}"
                  HorizontalAlignment="Stretch"
                  Padding="12,8" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
