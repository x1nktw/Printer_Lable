<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabelPrint.UI.ViewModels"
        xmlns:pages="using:LabelPrint.UI.Views.Pages"
        xmlns:ui="using:LabelPrint.UI"
        x:Class="LabelPrint.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="LabelPrint Pro"
        Width="1480"
        Height="900"
        MinWidth="1200"
        MinHeight="720"
        Background="{DynamicResource AppContentBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        SystemDecorations="Full">

  <DockPanel>
    <!-- Custom titlebar matching app chrome -->
    <Border DockPanel.Dock="Top"
            Height="40"
            Background="{DynamicResource AppSidebarBackground}"
            BorderBrush="{DynamicResource AppSidebarBorder}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    Margin="14,0,0,0"
                    IsHitTestVisible="False">
          <Path Classes="brand-mark"
                Data="{x:Static ui:AppIcons.Brand}"
                Width="16" Height="16"
                VerticalAlignment="Center" />
          <TextBlock Text="LabelPrint Pro"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource AppPrimaryForeground}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="titlebar-btn"
                  Click="OnMinimizeClick"
                  ToolTip.Tip="Свернуть">
            <Path Width="10" Height="10"
                  Stretch="None"
                  Stroke="{DynamicResource AppPrimaryForeground}"
                  StrokeThickness="1.25"
                  StrokeLineCap="Square"
                  Data="M 0.5,5 H 9.5" />
          </Button>
          <Button Classes="titlebar-btn"
                  x:Name="MaximizeButton"
                  Click="OnMaximizeClick"
                  ToolTip.Tip="Развернуть">
            <Panel Width="10" Height="10">
              <Path x:Name="MaximizeGlyph"
                    Width="10" Height="10"
                    Stretch="None"
                    Stroke="{DynamicResource AppPrimaryForeground}"
                    StrokeThickness="1.25"
                    StrokeLineCap="Square"
                    StrokeJoin="Miter"
                    Fill="Transparent"
                    Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"
                    IsVisible="True" />
              <Path x:Name="RestoreGlyph"
                    Width="10" Height="10"
                    Stretch="None"
                    Stroke="{DynamicResource AppPrimaryForeground}"
                    StrokeThickness="1.25"
                    StrokeLineCap="Square"
                    StrokeJoin="Miter"
                    Fill="Transparent"
                    Data="M 2.5,0.5 H 9.5 V 7.5 H 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z"
                    IsVisible="False" />
            </Panel>
          </Button>
          <Button Classes="titlebar-btn titlebar-btn-close"
                  Click="OnCloseClick"
                  ToolTip.Tip="Закрыть">
            <Path Width="10" Height="10"
                  Stretch="None"
                  Stroke="{DynamicResource AppPrimaryForeground}"
                  StrokeThickness="1.25"
                  StrokeLineCap="Square"
                  Data="M 1,1 L 9,9 M 9,1 L 1,9" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="Auto,*">
      <!-- Fixed icon rail: content stays left-aligned; width clips text on collapse -->
      <Border x:Name="SidebarHost"
              Classes="sidebar-host"
              Width="{Binding SidebarWidth}"
              Background="{DynamicResource AppSidebarBackground}"
              BorderBrush="{DynamicResource AppSidebarBorder}"
              BorderThickness="0,0,1,0"
              Padding="12,12"
              ClipToBounds="True">
        <DockPanel>
          <!-- Brand + logo -->
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <Border Height="40"
                    Padding="10,0"
                    Classes="sidebar-row">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Path Classes="brand-mark"
                      Data="{x:Static ui:AppIcons.Brand}"
                      Width="20" Height="20"
                      VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center"
                            Opacity="{Binding SidebarExpandedOpacity}"
                            IsHitTestVisible="{Binding !IsSidebarCollapsed}">
                  <StackPanel.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    </Transitions>
                  </StackPanel.Transitions>
                  <TextBlock Text="LabelPrint"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppPrimaryForeground}" />
                  <TextBlock Text="Pro"
                             FontSize="11"
                             Foreground="{DynamicResource AppMutedForeground}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Button Classes="sidebar-rail"
                    Command="{Binding ToggleSidebarCommand}"
                    ToolTip.Tip="{Binding SidebarToggleTooltip}"
                    HorizontalAlignment="Stretch"
                    Height="40"
                    Padding="10,0">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Path Classes="app-icon"
                      Data="{Binding SidebarToggleIcon}"
                      Width="18" Height="18" />
                <TextBlock Text="{Binding SidebarToggleTooltip}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Opacity="{Binding SidebarExpandedOpacity}"
                           Foreground="{DynamicResource AppMutedForeground}">
                  <TextBlock.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    </Transitions>
                  </TextBlock.Transitions>
                </TextBlock>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Nav: left-aligned icons stay in place while titles clip away -->
          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNavItem}"
                   Classes="nav"
                   Classes.collapsed="{Binding IsSidebarCollapsed}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            Height="20"
                            ToolTip.Tip="{Binding Title}">
                  <Path Classes="app-icon"
                        Data="{Binding Icon}"
                        Width="18" Height="18"
                        VerticalAlignment="Center" />
                  <TextBlock Classes="nav-title"
                             Text="{Binding Title}"
                             FontSize="13"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppPrimaryForeground}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource AppContentBackground}"
              Padding="28,24">
        <Border x:Name="PageHost" Classes="page-host" Opacity="1">
          <ContentControl Content="{Binding CurrentPage}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:HomeViewModel">
                <pages:HomePageView />
              </DataTemplate>
              <DataTemplate DataType="vm:CatalogViewModel">
                <pages:CatalogPageView />
              </DataTemplate>
              <DataTemplate DataType="vm:RawMaterialsViewModel">
                <pages:RawMaterialsPageView />
              </DataTemplate>
              <DataTemplate DataType="vm:TemplatesViewModel">
                <pages:TemplatesPageView />
              </DataTemplate>
              <DataTemplate DataType="vm:TemplateEditorViewModel">
                <pages:TemplateEditorPageView />
              </DataTemplate>
              <DataTemplate DataType="vm:SettingsViewModel">
                <pages:SettingsPageView />
              </DataTemplate>
              <DataTemplate DataType="vm:PrintersViewModel">
                <pages:PrintersPageView />
              </DataTemplate>
              <DataTemplate DataType="vm:QueueViewModel">
                <pages:QueuePageView />
              </DataTemplate>
              <DataTemplate DataType="vm:HistoryViewModel">
                <pages:HistoryPageView />
              </DataTemplate>
              <DataTemplate DataType="vm:OrdersViewModel">
                <pages:OrdersPageView />
              </DataTemplate>
              <DataTemplate DataType="vm:PlaceholderViewModel">
                <pages:PlaceholderPageView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>
      </Border>
    </Grid>
  </DockPanel>
</Window>
