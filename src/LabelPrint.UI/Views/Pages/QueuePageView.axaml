<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:ui="using:LabelPrint.UI"
             x:Class="LabelPrint.UI.Views.Pages.QueuePageView"
             x:DataType="vm:QueueViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Classes="page-title" />
      <TextBlock Text="{Binding StatusMessage}" Classes="page-subtitle" TextWrapping="Wrap" />
      <Border Classes="app-card" Padding="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding LoadCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="app-icon-sm" Data="{x:Static ui:AppIcons.Refresh}" />
              <TextBlock Text="Обновить" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="Отменить" Command="{Binding CancelSelectedCommand}" />
          <Button Content="Повторить" Command="{Binding RetrySelectedCommand}" />
          <Button Classes="accent" Command="{Binding ReprintSelectedCommand}">
            <TextBlock Text="Перепечатать"  />
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Classes="app-panel">
      <DataGrid Classes="app-grid"
                ItemsSource="{Binding Jobs}"
                SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                Background="Transparent"
                RowBackground="Transparent">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Задание" Binding="{Binding Title}" Width="*" MinWidth="180" />
          <DataGridTextColumn Header="Принтер" Binding="{Binding PrinterName}" Width="140" MinWidth="120" />
          <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110" />
          <DataGridTextColumn Header="Копии" Binding="{Binding Copies}" Width="70" />
          <DataGridTextColumn Header="Повторы" Binding="{Binding RetryCount}" Width="80" />
          <DataGridTextColumn Header="Ошибка" Binding="{Binding FailureReason}" Width="200" MinWidth="160" />
          <DataGridTextColumn Header="Создано" Binding="{Binding CreatedAt}" Width="160" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
