<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:ui="using:LabelPrint.UI"
             x:Class="LabelPrint.UI.Views.Pages.PrintersPageView"
             x:DataType="vm:PrintersViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Classes="page-title" />
      <TextBlock Text="{Binding StatusMessage}" Classes="page-subtitle" TextWrapping="Wrap" />
      <Border Classes="app-card" Padding="12">
        <WrapPanel>
          <Button Command="{Binding LoadCommand}" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="app-icon-sm" Data="{x:Static ui:AppIcons.Refresh}" />
              <TextBlock Text="Обновить" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="Добавить виртуальный" Command="{Binding NewVirtualPrinterCommand}" Margin="0,0,8,8" />
          <Button Content="Изменить" Command="{Binding EditSelectedCommand}" Margin="0,0,8,8" />
          <Button Content="По умолчанию" Command="{Binding SetDefaultCommand}" Margin="0,0,8,8" />
          <Button Content="Отключить" Command="{Binding ArchiveSelectedCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </Border>
    </StackPanel>

    <Border DockPanel.Dock="Bottom"
            Classes="app-card"
            IsVisible="{Binding IsEditorOpen}"
            Margin="0,12,0,0"
            MaxHeight="420">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Classes="accent" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="app-icon-sm" Data="{x:Static ui:AppIcons.Save}" />
              <TextBlock Text="Сохранить" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="Отмена" Command="{Binding CancelEditCommand}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" MaxWidth="640">
            <TextBlock Text="Настройки принтера" Classes="section-title" />
            <TextBox Watermark="Название" Text="{Binding EditName}" />
            <ComboBox ItemsSource="{Binding ProtocolOptions}"
                      SelectedItem="{Binding EditProtocol}"
                      HorizontalAlignment="Stretch" />
            <TextBox Watermark="Подключение (очередь Windows, host:port для TSPL, папка для File)"
                     Text="{Binding EditConnectionString}" />
            <WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
                <NumericUpDown Value="{Binding EditPaperWidthMm}" Minimum="10" Maximum="300"
                               Width="120" MinWidth="100" FormatString="0.#" Increment="1" />
                <TextBlock Text="мм ширина ленты" VerticalAlignment="Center" Classes="page-subtitle" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <NumericUpDown Value="{Binding EditDpi}" Minimum="72" Maximum="600"
                               Width="100" MinWidth="80" Increment="1" />
                <TextBlock Text="DPI" VerticalAlignment="Center" Classes="page-subtitle" />
              </StackPanel>
            </WrapPanel>
            <CheckBox Content="Повернуть 90° (макет 40×58 на ленте 58 мм / горизонтальные этикетки)"
                      IsChecked="{Binding EditRotate90}" />
            <TextBlock Text="Если печать уезжает на 2 этикетки — включите поворот или укажите реальную ширину ленты (часто 58)."
                       Classes="page-subtitle" TextWrapping="Wrap" />
            <WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
                <NumericUpDown Value="{Binding EditPrintOffsetXMm}" Minimum="-20" Maximum="20"
                               Width="100" MinWidth="80" FormatString="0.#" Increment="0.5" />
                <TextBlock Text="смещ. X мм" VerticalAlignment="Center" Classes="page-subtitle" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <NumericUpDown Value="{Binding EditPrintOffsetYMm}" Minimum="-20" Maximum="20"
                               Width="100" MinWidth="80" FormatString="0.#" Increment="0.5" />
                <TextBlock Text="смещ. Y мм" VerticalAlignment="Center" Classes="page-subtitle" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Text="Windows: если верх обрезан и снизу пусто — уменьшите Y (например −2). Если низ обрезан — увеличьте Y."
                       Classes="page-subtitle" TextWrapping="Wrap" />
            <CheckBox Content="Принтер по умолчанию" IsChecked="{Binding EditIsDefault}" />
            <TextBox Watermark="Примечания" Text="{Binding EditNotes}" AcceptsReturn="True" MinHeight="48" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Classes="app-panel">
      <DataGrid Classes="app-grid"
                ItemsSource="{Binding Printers}"
                SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                Background="Transparent"
                RowBackground="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="100" />
          <DataGridTextColumn Header="Протокол" Binding="{Binding Protocol}" Width="Auto" MinWidth="70" />
          <DataGridTextColumn Header="Подключение" Binding="{Binding ConnectionString}" Width="2*" MinWidth="100" />
          <DataGridTextColumn Header="DPI" Binding="{Binding Dpi}" Width="Auto" MinWidth="48" />
          <DataGridCheckBoxColumn Header="По умолч." Binding="{Binding IsDefault}" Width="Auto" MinWidth="72" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
