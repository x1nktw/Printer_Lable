<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:dto="using:LabelPrint.Application.DTOs"
             xmlns:ui="using:LabelPrint.UI"
             x:Class="LabelPrint.UI.Views.Pages.CatalogPageView"
             x:DataType="vm:CatalogViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Classes="page-title" />
      <TextBlock Text="{Binding StatusMessage}" Classes="page-subtitle" TextWrapping="Wrap" />
    </StackPanel>

    <TabControl SelectedIndex="{Binding SelectedSectionIndex}">
      <TabItem Header="Товары">
        <DockPanel Margin="0,8,0,0">
          <Border DockPanel.Dock="Top" Classes="app-card" Padding="12" Margin="0,0,0,12">
            <WrapPanel>
              <TextBox Watermark="Поиск по названию / артикулу / штрихкоду"
                       Text="{Binding SearchText}"
                       MinWidth="220" Width="260" Margin="0,0,8,8" />
              <Button Content="Найти" Command="{Binding LoadCommand}" Margin="0,0,8,8" />
              <Button Content="Добавить" Command="{Binding NewProductCommand}" Margin="0,0,8,8" />
              <Button Content="Изменить" Command="{Binding EditSelectedCommand}" Margin="0,0,8,8" />
              <Button Content="Удалить" Command="{Binding ArchiveSelectedCommand}" Margin="0,0,8,8" />
              <Button Content="Поля" Command="{Binding ToggleFieldManagerCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </Border>

          <Border DockPanel.Dock="Bottom"
                  Classes="app-card"
                  IsVisible="{Binding IsEditorOpen}"
                  Margin="0,12,0,0">
            <ScrollViewer MaxHeight="320">
              <StackPanel Spacing="8">
                <TextBlock Text="Карточка товара" Classes="section-title" />
                <TextBox Watermark="Название" Text="{Binding EditName}" />
                <TextBox Watermark="Артикул" Text="{Binding EditSku}" />
                <TextBox Watermark="Штрихкод" Text="{Binding EditBarcode}" />
                <NumericUpDown Minimum="0" Maximum="999999" Increment="1" FormatString="0.##"
                               Value="{Binding EditPrice}" />
                <ItemsControl ItemsSource="{Binding CustomFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomFieldEditVm">
                      <StackPanel Margin="0,4,0,0" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" Classes="page-subtitle" />
                        <TextBox Text="{Binding Value}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Classes="app-icon-sm" Data="{x:Static ui:AppIcons.Save}"  />
                      <TextBlock Text="Сохранить"  VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Content="Отмена" Command="{Binding CancelEditCommand}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border DockPanel.Dock="Bottom"
                  Classes="app-card"
                  IsVisible="{Binding ShowFieldManager}"
                  Margin="0,12,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="Пользовательские поля (EAV)" Classes="section-title" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Watermark="Имя поля" Text="{Binding NewFieldName}" Width="200" />
                <CheckBox Content="Обязательное" IsChecked="{Binding NewFieldRequired}" VerticalAlignment="Center" />
                <Button Content="Добавить поле" Command="{Binding CreateCustomFieldCommand}" />
              </StackPanel>
              <ListBox ItemsSource="{Binding FieldDefinitions}"
                       SelectedItem="{Binding SelectedFieldDefinition}"
                       MaxHeight="140"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="dto:CustomFieldDefinitionDto">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="Удалить поле" Command="{Binding ArchiveSelectedFieldCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <DockPanel>
            <Button DockPanel.Dock="Bottom"
                    Content="Загрузить ещё"
                    Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding CanLoadMore}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0" />
            <Border Classes="app-panel">
              <DataGrid Classes="app-grid"
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedProduct}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        Background="Transparent"
                        RowBackground="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="100" />
                  <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="Auto" MinWidth="64" />
                  <DataGridTextColumn Header="Штрихкод" Binding="{Binding Barcode}" Width="Auto" MinWidth="72" />
                  <DataGridTextColumn Header="Цена" Binding="{Binding PriceAmount}" Width="Auto" MinWidth="56" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </DockPanel>
      </TabItem>

      <TabItem Header="Маркировка">
        <DockPanel Margin="0,8,0,0">
          <Border DockPanel.Dock="Top" Classes="app-card" Padding="12" Margin="0,0,0,12">
            <StackPanel Spacing="8">
              <WrapPanel>
                <TextBox Watermark="Поиск…" Text="{Binding SearchText}"
                         MinWidth="220" Width="260" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding FilterMarkingRootOptions}"
                          SelectedItem="{Binding FilterMarkingRootOption}"
                          Width="160" Margin="0,0,8,8"
                          PlaceholderText="Категория">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryOptionVm">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding FilterMarkingSubcategoryOptions}"
                          SelectedItem="{Binding FilterMarkingSubcategoryOption}"
                          Width="160" Margin="0,0,8,8"
                          IsVisible="{Binding HasFilterMarkingSubcategories}"
                          PlaceholderText="Подкатегория">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryOptionVm">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Watermark="Новая подкатегория…"
                         Text="{Binding NewMarkingSubcategoryName}"
                         Width="180" Margin="0,0,8,8"
                         IsVisible="{Binding CanAddMarkingSubcategory}" />
                <Button Content="Добавить подкатегорию"
                        Command="{Binding AddMarkingSubcategoryCommand}"
                        Margin="0,0,8,8"
                        IsVisible="{Binding CanAddMarkingSubcategory}" />
                <Button Content="Найти" Command="{Binding LoadCommand}" Margin="0,0,8,8" />
                <Button Content="Добавить" Command="{Binding NewProductCommand}" Margin="0,0,8,8" />
                <Button Content="Изменить" Command="{Binding EditSelectedCommand}" Margin="0,0,8,8" />
                <Button Content="Удалить" Command="{Binding ArchiveSelectedCommand}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="Выберите категорию, чтобы видеть/добавлять подкатегории. Печать — в разделе «Маркировка» слева."
                         Classes="page-subtitle" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border DockPanel.Dock="Bottom"
                  Classes="app-card"
                  IsVisible="{Binding IsEditorOpen}"
                  Margin="0,12,0,0"
                  MaxHeight="360">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button Classes="accent" Command="{Binding SaveCommand}">
                  <TextBlock Text="Сохранить" />
                </Button>
                <Button Content="Отмена" Command="{Binding CancelEditCommand}" />
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="8">
                <TextBlock Text="Карточка маркировки" Classes="section-title" />
                <TextBox Watermark="Название" Text="{Binding EditName}" />
                <TextBox Watermark="Артикул" Text="{Binding EditSku}" />
                <TextBlock Text="Категория" Classes="page-subtitle" />
                <ComboBox ItemsSource="{Binding MarkingRootOptions}"
                          SelectedItem="{Binding EditMarkingRootOption}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryOptionVm">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding MarkingSubcategoryOptions}"
                          SelectedItem="{Binding EditMarkingSubcategoryOption}"
                          IsVisible="{Binding HasMarkingSubcategories}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryOptionVm">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Удалить подкатегорию"
                        Command="{Binding DeleteMarkingSubcategoryCommand}"
                        IsVisible="{Binding CanDeleteMarkingSubcategory}"
                        HorizontalAlignment="Left" />
                <TextBlock Text="Срок годности" Classes="page-subtitle" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Minimum="1" Maximum="3650" Increment="1" FormatString="0"
                                 Value="{Binding EditShelfLifeValue}" />
                  <ComboBox ItemsSource="{Binding ShelfLifeUnitOptions}"
                            SelectedItem="{Binding EditShelfLifeUnitOption}"
                            Width="110">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShelfLifeUnitOptionVm">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <TextBlock Text="Температурный режим" Classes="page-subtitle" />
                <ComboBox ItemsSource="{Binding TemperaturePresets}"
                          SelectedItem="{Binding EditTemperatureRegime}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Выберите пресет" />
                <TextBox Watermark="или введите свой режим"
                         Text="{Binding EditTemperatureRegime}" />
                <TextBlock Text="Иконка" Classes="page-subtitle" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding IconKeys}"
                            SelectedItem="{Binding EditProductIconKey}"
                            Width="200"
                            PlaceholderText="без иконки" />
                  <Button Content="Импорт PNG…" Command="{Binding ImportAddonIconCommand}" />
                  <Button Content="Удалить иконку"
                          Command="{Binding DeleteProductIconCommand}"
                          IsVisible="{Binding CanDeleteProductIcon}"
                          ToolTip.Tip="Убрать из списка (встроенные скрываются, свои PNG удаляются)" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding CustomFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomFieldEditVm">
                      <StackPanel Margin="0,4,0,0" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" Classes="page-subtitle" />
                        <TextBox Text="{Binding Value}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <DockPanel>
            <Button DockPanel.Dock="Bottom"
                    Content="Загрузить ещё"
                    Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding CanLoadMore}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0" />
            <Border Classes="app-panel">
              <DataGrid Classes="app-grid"
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedRawProduct}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        Background="Transparent"
                        RowBackground="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="100" />
                  <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="Auto" MinWidth="72" />
                  <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="Auto" MinWidth="56" />
                  <DataGridTextColumn Header="Срок" Binding="{Binding ShelfLifeDisplay}" Width="Auto" MinWidth="48" />
                  <DataGridTextColumn Header="t°" Binding="{Binding TemperatureRegime}" Width="Auto" MinWidth="56" />
                  <DataGridTextColumn Header="Иконка" Binding="{Binding IconKey}" Width="Auto" MinWidth="56" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </DockPanel>
        </DockPanel>
      </TabItem>

      <TabItem Header="Добавки">
        <DockPanel Margin="0,8,0,0">
          <Border DockPanel.Dock="Top" Classes="app-card" Padding="12" Margin="0,0,0,12">
            <StackPanel Spacing="8">
              <TextBlock Text="Сопоставьте названия добавок из FrontPad с иконками на кухонной этикетке. Импортируйте свои PNG — встроенных иконок нет."
                         Classes="page-subtitle" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Content="Добавить" Command="{Binding NewAddonCommand}" Margin="0,0,8,8" />
                <Button Content="Изменить" Command="{Binding EditSelectedAddonCommand}" Margin="0,0,8,8" />
                <Button Content="Удалить" Command="{Binding ArchiveSelectedAddonCommand}" Margin="0,0,8,8" />
                <Button Command="{Binding LoadCommand}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="app-icon-sm" Data="{x:Static ui:AppIcons.Refresh}" />
                    <TextBlock Text="Обновить" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border DockPanel.Dock="Bottom"
                  Classes="app-card"
                  IsVisible="{Binding IsAddonEditorOpen}"
                  Margin="0,12,0,0">
            <StackPanel Spacing="8" MaxWidth="520">
              <TextBlock Text="Добавка и иконка" Classes="section-title" />
              <TextBox Watermark="Название (как в FrontPad)" Text="{Binding EditAddonName}" />
              <TextBox Watermark="Доп. совпадения через запятую" Text="{Binding EditAddonAliases}" />
              <TextBlock Text="Иконка" Classes="page-subtitle" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding IconKeys}"
                          SelectedItem="{Binding EditAddonIconKey}"
                          Width="200" />
                <Button Content="Импорт PNG…" Command="{Binding ImportAddonIconCommand}" />
                <Button Content="Удалить иконку"
                        Command="{Binding DeleteAddonIconCommand}"
                        IsVisible="{Binding CanDeleteAddonIcon}"
                        ToolTip.Tip="Убрать из списка (встроенные скрываются, свои PNG удаляются)" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Command="{Binding SaveAddonCommand}">
                  <TextBlock Text="Сохранить"  />
                </Button>
                <Button Content="Отмена" Command="{Binding CancelAddonEditCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="app-panel">
            <DataGrid Classes="app-grid"
                      ItemsSource="{Binding Addons}"
                      SelectedItem="{Binding SelectedAddon}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      RowBackground="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="100" />
                <DataGridTextColumn Header="Совпадения" Binding="{Binding MatchAliases}" Width="2*" MinWidth="80" />
                <DataGridTextColumn Header="Иконка" Binding="{Binding IconKey}" Width="Auto" MinWidth="56" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
