<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:controls="using:LabelPrint.UI.Controls"
             xmlns:svc="using:LabelPrint.Application.Abstractions.Services"
             x:Class="LabelPrint.UI.Views.Pages.TemplatesPageView"
             x:DataType="vm:TemplatesViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Watermark="Поиск" Text="{Binding SearchText}" Width="240" />
        <Button Content="Найти" Command="{Binding LoadCommand}" />
        <Button Content="Изменить" Command="{Binding EditSelectedCommand}" />
        <Button Content="Копировать" Command="{Binding DuplicateSelectedCommand}" />
        <Button Content="Экспорт JSON" Command="{Binding ExportSelectedJsonCommand}" ToolTip.Tip="Экспорт JSON шаблона" />
        <Button Content="Удалить" Command="{Binding DeleteSelectedCommand}" />
      </StackPanel>
      <Border Padding="10" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Watermark="Название" Text="{Binding NewName}" Width="200" Height="28" MinHeight="28" Padding="8,2" />
          <TextBlock Text="Размер" VerticalAlignment="Center" Opacity="0.7" />
          <controls:PlusMinusNumeric Value="{Binding NewWidth}" Minimum="10" Maximum="200"
                                     Increment="1" FormatString="0.#" FieldWidth="56"
                                     ToolTip.Tip="Ширина, мм" />
          <TextBlock Text="×" VerticalAlignment="Center" />
          <controls:PlusMinusNumeric Value="{Binding NewHeight}" Minimum="10" Maximum="200"
                                     Increment="1" FormatString="0.#" FieldWidth="56"
                                     ToolTip.Tip="Высота, мм" />
          <TextBlock Text="мм" VerticalAlignment="Center" Opacity="0.7" />
          <Button Content="Создать" Command="{Binding CreateCommand}" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" />
    </StackPanel>

    <DataGrid ItemsSource="{Binding Templates}"
              SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              Margin="0,12,0,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Название"
                            Binding="{Binding Name}"
                            Width="*"
                            MinWidth="180" />
        <DataGridTextColumn Header="Ширина, мм"
                            Binding="{Binding WidthMm, StringFormat=\{0:0.#\}}"
                            Width="110"
                            MinWidth="100" />
        <DataGridTextColumn Header="Высота, мм"
                            Binding="{Binding HeightMm, StringFormat=\{0:0.#\}}"
                            Width="110"
                            MinWidth="100" />
        <DataGridTemplateColumn Header="Используется"
                                Width="150"
                                MinWidth="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="svc:TemplateListItemDto">
              <CheckBox IsChecked="{Binding IsInUse}"
                        IsEnabled="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
