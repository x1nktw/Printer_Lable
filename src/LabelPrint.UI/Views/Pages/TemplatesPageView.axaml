<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:controls="using:LabelPrint.UI.Controls"
             xmlns:svc="using:LabelPrint.Application.Abstractions.Services"
             xmlns:ui="using:LabelPrint.UI"
             x:Class="LabelPrint.UI.Views.Pages.TemplatesPageView"
             x:DataType="vm:TemplatesViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Classes="page-title" />
      <TextBlock Text="{Binding StatusMessage}" Classes="page-subtitle" />
      <Border Classes="app-card" Padding="12">
        <WrapPanel>
          <TextBox Watermark="Поиск" Text="{Binding SearchText}" Width="220" Margin="0,0,8,8" />
          <Button Content="Найти" Command="{Binding LoadCommand}" Margin="0,0,8,8" />
          <Button Content="Изменить" Command="{Binding EditSelectedCommand}" Margin="0,0,8,8" />
          <Button Content="Копировать" Command="{Binding DuplicateSelectedCommand}" Margin="0,0,8,8" />
          <Button Content="Экспорт JSON" Command="{Binding ExportSelectedJsonCommand}" ToolTip.Tip="Экспорт JSON шаблона" Margin="0,0,8,8" />
          <Button Content="Удалить" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </Border>
      <Border Classes="app-card" Padding="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Watermark="Название" Text="{Binding NewName}" Width="200" />
          <TextBlock Text="Размер" VerticalAlignment="Center" Classes="page-subtitle" />
          <controls:PlusMinusNumeric Value="{Binding NewWidth}" Minimum="10" Maximum="200"
                                     Increment="1" FormatString="0.#" FieldWidth="56"
                                     ToolTip.Tip="Ширина, мм" />
          <TextBlock Text="×" VerticalAlignment="Center" Classes="page-subtitle" />
          <controls:PlusMinusNumeric Value="{Binding NewHeight}" Minimum="10" Maximum="200"
                                     Increment="1" FormatString="0.#" FieldWidth="56"
                                     ToolTip.Tip="Высота, мм" />
          <TextBlock Text="мм" VerticalAlignment="Center" Classes="page-subtitle" />
          <Button Classes="accent" Command="{Binding CreateCommand}">
            <TextBlock Text="Создать" Foreground="White" />
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Classes="app-panel">
      <DataGrid Classes="app-grid"
                ItemsSource="{Binding Templates}"
                SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                BorderThickness="0"
                Background="Transparent"
                RowBackground="Transparent">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Название"
                              Binding="{Binding Name}"
                              Width="*"
                              MinWidth="180" />
          <DataGridTextColumn Header="Ширина, мм"
                              Binding="{Binding WidthMm, StringFormat=\{0:0.#\}}"
                              Width="110"
                              MinWidth="100" />
          <DataGridTextColumn Header="Высота, мм"
                              Binding="{Binding HeightMm, StringFormat=\{0:0.#\}}"
                              Width="110"
                              MinWidth="100" />
          <DataGridTemplateColumn Header="Используется"
                                  Width="150"
                                  MinWidth="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="svc:TemplateListItemDto">
                <CheckBox IsChecked="{Binding IsInUse}"
                          IsEnabled="False"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
