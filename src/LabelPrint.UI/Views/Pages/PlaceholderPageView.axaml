<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             x:Class="LabelPrint.UI.Views.Pages.PlaceholderPageView"
             x:DataType="vm:PlaceholderViewModel">
  <StackPanel Spacing="12" Margin="4" MaxWidth="720">
    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Message}"
               Opacity="0.8"
               TextWrapping="Wrap"
               LineHeight="22" />
    <Border Padding="12"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock Text="Раздел открыт. Функции появятся по мере реализации этапов — без имитации работы."
                 Opacity="0.7"
                 TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
