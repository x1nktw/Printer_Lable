<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             x:Class="LabelPrint.UI.Views.Pages.PlaceholderPageView"
             x:DataType="vm:PlaceholderViewModel">
  <StackPanel Spacing="14" Margin="4" MaxWidth="720">
    <TextBlock Text="{Binding Title}" Classes="page-title" />
    <TextBlock Text="{Binding Message}"
               Classes="page-subtitle"
               TextWrapping="Wrap"
               LineHeight="22" />
    <Border Classes="app-card">
      <TextBlock Text="Раздел открыт. Функции появятся по мере реализации этапов — без имитации работы."
                 Classes="page-subtitle"
                 TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
