<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:dto="using:LabelPrint.Application.DTOs"
             xmlns:ui="using:LabelPrint.UI"
             x:Class="LabelPrint.UI.Views.Pages.HistoryPageView"
             x:DataType="vm:HistoryViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Classes="page-title" />
      <TextBlock Text="{Binding StatusMessage}" Classes="page-subtitle" TextWrapping="Wrap" />
      <Border Classes="app-card" Padding="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding LoadCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="app-icon-sm" Data="{x:Static ui:AppIcons.Refresh}" />
              <TextBlock Text="Обновить" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="Ещё" Command="{Binding LoadMoreCommand}" IsEnabled="{Binding CanLoadMore}" />
          <Button Classes="accent" Command="{Binding ReprintSelectedCommand}">
            <TextBlock Text="Перепечатать" Foreground="White" />
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Classes="app-panel">
      <DataGrid Classes="app-grid"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding Selected}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                Background="Transparent"
                RowBackground="Transparent">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Дата" Binding="{Binding PrintedAt}" Width="160" />
          <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" MinWidth="180" />
          <DataGridTextColumn Header="Принтер" Binding="{Binding PrinterName}" Width="140" />
          <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="160" MinWidth="120" />
          <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110" />
          <DataGridTextColumn Header="Копии" Binding="{Binding Copies}" Width="70" />
          <DataGridTextColumn Header="Ошибка" Binding="{Binding FailureReason}" Width="200" MinWidth="160" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
