<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:dto="using:LabelPrint.Application.DTOs"
             x:Class="LabelPrint.UI.Views.Pages.HistoryPageView"
             x:DataType="vm:HistoryViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Обновить" Command="{Binding LoadCommand}" />
        <Button Content="Ещё" Command="{Binding LoadMoreCommand}" IsEnabled="{Binding CanLoadMore}" />
        <Button Content="Перепечатать" Command="{Binding ReprintSelectedCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>

    <DataGrid ItemsSource="{Binding Entries}"
              SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              Margin="0,12,0,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Дата" Binding="{Binding PrintedAt}" Width="160" />
        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" MinWidth="180" />
        <DataGridTextColumn Header="Принтер" Binding="{Binding PrinterName}" Width="140" />
        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="160" MinWidth="120" />
        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110" />
        <DataGridTextColumn Header="Копии" Binding="{Binding Copies}" Width="70" />
        <DataGridTextColumn Header="Ошибка" Binding="{Binding FailureReason}" Width="200" MinWidth="160" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
