<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             x:Class="LabelPrint.UI.Views.Pages.HomePageView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="4" MaxWidth="880">
      <!-- Hero -->
      <Border Classes="app-card" Padding="28">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <Border Grid.RowSpan="2"
                  Width="88" Height="88"
                  CornerRadius="18"
                  ClipToBounds="True"
                  Margin="0,0,22,0"
                  BorderBrush="{DynamicResource AppSidebarBorder}"
                  BorderThickness="1"
                  VerticalAlignment="Top">
            <Image Source="/Assets/app-icon.png"
                   Width="88" Height="88"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
          </Border>

          <StackPanel Grid.Column="1"
                      Spacing="6"
                      HorizontalAlignment="Left">
            <TextBlock Text="LabelPrint Pro"
                       FontSize="28"
                       FontWeight="SemiBold"
                       LetterSpacing="-0.4"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       Foreground="{DynamicResource AppPrimaryForeground}" />
            <TextBlock Text="{Binding VersionLabel}"
                       Classes="page-subtitle"
                       FontSize="14"
                       HorizontalAlignment="Left"
                       TextAlignment="Left" />
            <TextBlock Text="{Binding Subtitle}"
                       TextWrapping="Wrap"
                       TextAlignment="Left"
                       HorizontalAlignment="Left"
                       Classes="page-subtitle"
                       Margin="0,6,0,0"
                       MaxWidth="560" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- System status -->
      <Border Classes="app-card" Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="Статус системы" Classes="section-title" />
          <ItemsControl ItemsSource="{Binding StatusItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SystemStatusItem">
                <Grid ColumnDefinitions="28,*">
                  <TextBlock Text="{Binding Icon}"
                             FontSize="16"
                             VerticalAlignment="Top"
                             Margin="0,1,0,0"
                             Foreground="{Binding IconBrush}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppPrimaryForeground}" />
                    <TextBlock Text="{Binding Detail}"
                               Classes="page-subtitle"
                               FontSize="14"
                               IsVisible="{Binding HasDetail}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
