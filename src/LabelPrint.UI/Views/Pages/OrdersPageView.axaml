<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             x:Class="LabelPrint.UI.Views.Pages.OrdersPageView"
             x:DataType="vm:OrdersViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              Padding="10"
              CornerRadius="6">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding BannerMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock Text="{Binding InboxPath, StringFormat=Inbox: {0}}" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Watermark="Поиск № / клиент"
                 Text="{Binding SearchText}"
                 Width="220"
                 MinHeight="32" />
        <Button Content="Обновить" Command="{Binding LoadCommand}" />
        <Button Content="Inbox" Command="{Binding SyncInboxOnlyCommand}"
                ToolTip.Tip="Подтянуть JSON из inbox" />
        <Button Content="Пример" Command="{Binding CreateSampleCommand}"
                ToolTip.Tip="JSON с составом в inbox" />
        <Button Content="Печать выбранных" Command="{Binding PrintSelectedItemsCommand}" />
        <Button Content="Печать всех" Command="{Binding PrintAllItemsCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
      <DataGrid Grid.Column="0"
                ItemsSource="{Binding Orders}"
                SelectedItem="{Binding SelectedOrder}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                Margin="0,0,8,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="90" MinWidth="70" />
          <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="120" MinWidth="100" />
          <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*" MinWidth="120" />
          <DataGridTextColumn Header="Поз." Binding="{Binding ItemCount}" Width="60" />
          <DataGridTextColumn Header="Сопост." Binding="{Binding MatchedItemCount}" Width="80" />
          <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=\{0:0.##\}}" Width="90" />
        </DataGrid.Columns>
      </DataGrid>

      <DockPanel Grid.Column="1">
        <TextBlock DockPanel.Dock="Top"
                   Text="Позиции заказа"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding ItemRows}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="40" />
            <DataGridTextColumn Header="N/M" Binding="{Binding PositionLabel}" Width="60" IsReadOnly="True" />
            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="120" IsReadOnly="True" />
            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="90" IsReadOnly="True" />
            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70" IsReadOnly="True" />
            <DataGridTextColumn Header="Сопост." Binding="{Binding MatchLabel}" Width="90" IsReadOnly="True" />
            <DataGridCheckBoxColumn Header="Печать" Binding="{Binding IsPrinted}" Width="70" IsReadOnly="True" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
