<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:svc="using:LabelPrint.Application.Abstractions.Services"
             xmlns:ui="using:LabelPrint.UI"
             x:Class="LabelPrint.UI.Views.Pages.OrdersPageView"
             x:DataType="vm:OrdersViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Classes="page-title" />
      <TextBlock Text="{Binding StatusMessage}" Classes="page-subtitle" TextWrapping="Wrap" />

      <Border Classes="app-card" Padding="12">
        <WrapPanel>
          <TextBox Watermark="Поиск № / клиент"
                   Text="{Binding SearchText}"
                   Width="240"
                   Margin="0,0,8,8" />
          <Button Command="{Binding LoadCommand}" Margin="0,0,8,8" ToolTip.Tip="Обновить список">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="app-icon-sm" Data="{x:Static ui:AppIcons.Refresh}" />
              <TextBlock Text="Обновить" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding SyncInboxOnlyCommand}"
                  Margin="0,0,8,8"
                  ToolTip.Tip="Подтянуть JSON из inbox">
            <TextBlock Text="Inbox" VerticalAlignment="Center" />
          </Button>
          <Button Command="{Binding CreateSampleCommand}"
                  Margin="0,0,8,8"
                  ToolTip.Tip="JSON с составом в inbox">
            <TextBlock Text="Пример" VerticalAlignment="Center" />
          </Button>
          <ComboBox ItemsSource="{Binding Printers}"
                    SelectedItem="{Binding SelectedPrinter}"
                    PlaceholderText="Принтер"
                    MinWidth="180"
                    Margin="0,0,8,8">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:PrinterListItemDto">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding Templates}"
                    SelectedItem="{Binding SelectedTemplate}"
                    PlaceholderText="Шаблон"
                    MinWidth="200"
                    Margin="0,0,8,8">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:TemplateListItemDto">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Command="{Binding PrintSelectedItemsCommand}"
                  Margin="0,0,8,8">
            <TextBlock Text="Печать выбранных" VerticalAlignment="Center" />
          </Button>
          <Button Classes="accent"
                  Command="{Binding PrintAllItemsCommand}"
                  Margin="0,0,8,8">
            <TextBlock Text="Печать всех" VerticalAlignment="Center" />
          </Button>
        </WrapPanel>
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,14,*">
      <!-- Заказы -->
      <Border Grid.Column="0"
              Classes="app-panel"
              ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="app-panel-header">
            <TextBlock Text="Заказы" Classes="section-title" />
          </Border>
          <DataGrid Name="OrdersGrid"
                    Classes="app-grid"
                    ItemsSource="{Binding Orders}"
                    SelectedItem="{Binding SelectedOrder}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent"
                    RowBackground="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="Auto" MinWidth="56" />
              <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="Auto" MinWidth="64" />
              <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*" MinWidth="80" />
              <DataGridTextColumn Header="Поз." Binding="{Binding ItemCount}" Width="Auto" MinWidth="40" />
              <DataGridTextColumn Header="Кат." Binding="{Binding MatchedItemCount}" Width="Auto" MinWidth="40" />
              <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=\{0:0.##\}}" Width="Auto" MinWidth="56" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- Позиции -->
      <Border Grid.Column="2"
              Classes="app-panel"
              ClipToBounds="True">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="app-panel-header">
            <TextBlock Text="Позиции заказа" Classes="section-title" />
          </Border>
          <DataGrid Name="ItemsGrid"
                    Classes="app-grid"
                    ItemsSource="{Binding ItemRows}"
                    SelectedItem="{Binding SelectedItem}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent"
                    RowBackground="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header=" " Width="40" MinWidth="40">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:OrderItemRowVm">
                    <CheckBox IsChecked="{Binding IsSelected}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="#" Binding="{Binding PositionLabel}" Width="Auto" MinWidth="40" />
              <DataGridTemplateColumn Header="Название" Width="*" MinWidth="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:OrderItemRowVm">
                    <StackPanel Margin="4,2" Spacing="2">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AddonsDisplay}"
                                 Classes="page-subtitle"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasAddons}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Арт." Binding="{Binding Sku}" Width="Auto" MinWidth="48" />
              <DataGridTextColumn Header="Кол." Binding="{Binding Quantity}" Width="Auto" MinWidth="40" />
              <DataGridTextColumn Header="Связь" Binding="{Binding MatchLabel}" Width="Auto" MinWidth="48" />
              <DataGridTemplateColumn Header="✓" Width="Auto" MinWidth="40">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:OrderItemRowVm">
                    <CheckBox IsChecked="{Binding IsPrinted}"
                              IsEnabled="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
