<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LabelPrint.UI.ViewModels"
             xmlns:dto="using:LabelPrint.Application.DTOs"
             xmlns:svc="using:LabelPrint.Application.Abstractions.Services"
             xmlns:ui="using:LabelPrint.UI"
             x:Class="LabelPrint.UI.Views.Pages.RawMaterialsPageView"
             x:DataType="vm:RawMaterialsViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Classes="page-title" />
      <TextBlock Text="Маркировка: сырьё, заготовки, полуфабрикаты и соусы. На этикетке — название, дата, время, температура и срок годности."
                 Classes="page-subtitle"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusMessage}" Classes="page-subtitle" TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="300,*">
      <Border Grid.Column="0" Classes="app-panel" Margin="0,0,14,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="app-panel-header">
            <StackPanel Spacing="8">
              <TextBlock Text="Позиции" Classes="section-title" />
              <ComboBox ItemsSource="{Binding FilterRootOptions}"
                        SelectedItem="{Binding FilterRootOption}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Категория">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryOptionVm">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox ItemsSource="{Binding FilterSubcategoryOptions}"
                        SelectedItem="{Binding FilterSubcategoryOption}"
                        IsVisible="{Binding HasFilterSubcategories}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Подкатегория">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryOptionVm">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Watermark="Поиск" Text="{Binding SearchText}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding LoadCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="app-icon-sm" Data="{x:Static ui:AppIcons.Refresh}" />
                    <TextBlock Text="Обновить" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Content="Создать примеры" Command="{Binding SeedSamplesCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="6">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AppSidebarHover}" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:ProductListItemDto">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppPrimaryForeground}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="app-card" VerticalAlignment="Top" MaxWidth="440" HorizontalAlignment="Left">
        <StackPanel Spacing="12">
          <TextBlock Text="Печать" Classes="section-title" FontSize="15" />
          <TextBox Watermark="Название" Text="{Binding CustomName}" />
          <TextBlock Text="{Binding ShelfLifeHint}"
                     Classes="page-subtitle"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasShelfLifeHint}" />
          <ComboBox ItemsSource="{Binding Printers}"
                    SelectedItem="{Binding SelectedPrinter}"
                    PlaceholderText="Принтер">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:PrinterListItemDto">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding Templates}"
                    SelectedItem="{Binding SelectedTemplate}"
                    PlaceholderText="Шаблон">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="svc:TemplateListItemDto">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Своя дата/время" IsChecked="{Binding UseCustomLabelDateTime}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CalendarDatePicker SelectedDate="{Binding LabelDate}"
                                IsEnabled="{Binding UseCustomLabelDateTime}"
                                Width="160" />
            <TimePicker SelectedTime="{Binding LabelTime}"
                        IsEnabled="{Binding UseCustomLabelDateTime}"
                        Width="140"
                        ClockIdentifier="24HourClock" />
          </StackPanel>
          <Button Classes="accent"
                  Command="{Binding PrintCommand}"
                  HorizontalAlignment="Left"
                  Padding="16,10">
            <TextBlock Text="Печать этикетки"  FontWeight="SemiBold" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
