{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "LabelPrint": {
    "DatabaseFileName": "labelprint.db",
    "OrdersRefreshIntervalSeconds": 120,
    "MaxPrintRetries": 3,
    "HistoryRetentionMonths": 12,
    "BackupRetentionCount": 10
  },
  "PrintQueue": {
    "UseBackgroundWorker": true,
    "ProcessSynchronously": false,
    "PollIntervalMs": 500,
    "RetryBackoffBaseMs": 1000
  }
}
