            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#4E4034" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#F5EDE4" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#9A8A78" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#322820" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#4E4034" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
          <FluentTheme.Palettes>
            <ColorPaletteResources x:Key="Dark" Accent="#10A37F" />
            <ColorPaletteResources x:Key="Light" Accent="#10A37F" />
          </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector=":is(Control)">
          <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <!-- Global controls: ChatGPT / Claude soft chrome -->
        <Style Selector="Button">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="RenderTransformOrigin" Value="50%,50%" />
          <Setter Property="RenderTransform" Value="none" />
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
              <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Button:pointerover">
          <Setter Property="RenderTransform" Value="scale(1.015)" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppControlHover}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button:pressed">
          <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TextBox">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="SelectionBrush" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="CaretBrush" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{DynamicResource AppMutedForeground}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="TextBox:focus">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="ComboBox">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="Padding" Value="10,6" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
          <Setter Property="BorderBrush" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="ComboBox:focus">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="NumericUpDown">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="TextAlignment" Value="Center" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="controls:AdaptiveNumericWidth.IsEnabled" Value="True" />
          <Setter Property="controls:NumericUpDownSpinnerGlyphs.UsePlusMinus" Value="True" />
        </Style>
        <Style Selector="NumericUpDown:focus">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="TextAlignment" Value="Center" />
          <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ ScrollViewer#PART_ScrollViewer">
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ TextPresenter#PART_TextPresenter">
          <Setter Property="TextAlignment" Value="Center" />
          <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Clip spinner chrome so decrease button fill doesn't square off the right corners -->
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ Border">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="NumericUpDown /template/ RepeatButton#PART_IncreaseButton,
                         NumericUpDown /template/ RepeatButton#PART_DecreaseButton">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="MinWidth" Value="34" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="RenderTransform" Value="none" />
          <Setter Property="Transitions" Value="{x:Null}" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown /template/ RepeatButton#PART_IncreaseButton:pointerover,
                         NumericUpDown /template/ RepeatButton#PART_DecreaseButton:pointerover,
                         NumericUpDown /template/ RepeatButton#PART_IncreaseButton:pressed,
                         NumericUpDown /template/ RepeatButton#PART_DecreaseButton:pressed">
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="NumericUpDown /template/ RepeatButton#PART_IncreaseButton /template/ ContentPresenter,
                         NumericUpDown /template/ RepeatButton#PART_DecreaseButton /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="ClipToBounds" Value="True" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="NumericUpDown /template/ RepeatButton#PART_DecreaseButton /template/ ContentPresenter">
          <Setter Property="CornerRadius" Value="0,10,10,0" />
        </Style>
        <Style Selector="NumericUpDown /template/ RepeatButton#PART_IncreaseButton:pointerover /template/ ContentPresenter,
                         NumericUpDown /template/ RepeatButton#PART_DecreaseButton:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppControlHover}" />
        </Style>
        <Style Selector="NumericUpDown /template/ RepeatButton#PART_IncreaseButton:pressed /template/ ContentPresenter,
                         NumericUpDown /template/ RepeatButton#PART_DecreaseButton:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
        </Style>
        <Style Selector="NumericUpDown /template/ RepeatButton#PART_DecreaseButton:pointerover /template/ ContentPresenter,
                         NumericUpDown /template/ RepeatButton#PART_DecreaseButton:pressed /template/ ContentPresenter">
          <Setter Property="CornerRadius" Value="0,10,10,0" />
        </Style>

        <!-- Date field: same chrome as TextBox (rounded Border#Background) -->
        <Style Selector="CalendarDatePicker">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ Border#Background">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="CalendarDatePicker:pointerover /template/ Border#Background">
          <Setter Property="BorderBrush" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="CalendarDatePicker:focus-within /template/ Border#Background">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="4,0,0,0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Width" Value="28" />
          <Setter Property="Height" Value="28" />
          <Setter Property="Margin" Value="0,0,6,0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="8" />
          <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="RenderTransform" Value="none" />
          <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ Button#PART_Button:pointerover,
                         CalendarDatePicker /template/ Button#PART_Button:pressed">
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ Button#PART_Button:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarHover}" />
          <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Border.app-field-chrome:pointerover">
          <Setter Property="BorderBrush" Value="{DynamicResource AppMutedForeground}" />
        </Style>

        <!-- Calendar popup -->
        <Style Selector="Calendar">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Calendar Button">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Padding" Value="4" />
          <Setter Property="CornerRadius" Value="8" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="RenderTransform" Value="none" />
          <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="Calendar Button:pointerover, Calendar Button:pressed">
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Calendar Button:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarHover}" />
          <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Calendar Button:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
          <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="CheckBox">
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- Checked: Fluent sets BorderBrush from the fill brush — restore accent stroke on the box -->
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:indeterminate /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:indeterminate:pointerover /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:indeterminate:pressed /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="TabControl">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="Margin" Value="0,0,4,0" />
          <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="DataGrid">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="12" />
          <Setter Property="GridLinesVisibility" Value="Horizontal" />
          <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="RowBackground" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="DataGrid.app-grid">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridColumnHeader">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Padding" Value="12,10" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridRow">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
          <Setter Property="Fill" Value="{DynamicResource AppSidebarHover}" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
          <Setter Property="Fill" Value="{DynamicResource AppSidebarSelected}" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridCell">
          <Setter Property="Padding" Value="10,8" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ScrollViewer">
          <Setter Property="AllowAutoHide" Value="True" />
        </Style>

        <Style Selector="Path.app-icon">
          <Setter Property="Width" Value="18" />
          <Setter Property="Height" Value="18" />
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="Stroke" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="StrokeThickness" Value="1.75" />
          <Setter Property="StrokeLineCap" Value="Round" />
          <Setter Property="StrokeJoin" Value="Round" />
          <Setter Property="Fill" Value="Transparent" />
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Stroke" Duration="0:0:0.15" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Path.app-icon-sm">
          <Setter Property="Width" Value="14" />
          <Setter Property="Height" Value="14" />
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="Stroke" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="StrokeThickness" Value="1.5" />
          <Setter Property="StrokeLineCap" Value="Round" />
          <Setter Property="StrokeJoin" Value="Round" />
          <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Path.brand-mark">
          <Setter Property="Width" Value="18" />
          <Setter Property="Height" Value="18" />
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="Stroke" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="StrokeThickness" Value="1.6" />
          <Setter Property="StrokeLineCap" Value="Round" />
          <Setter Property="StrokeJoin" Value="Round" />
          <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Button.titlebar-btn">
          <Setter Property="Width" Value="46" />
          <Setter Property="Height" Value="40" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarHover}" />
        </Style>
        <Style Selector="Button.titlebar-btn:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
        </Style>
        <Style Selector="Button.titlebar-btn-close:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="#E81123" />
        </Style>
        <Style Selector="Button.titlebar-btn-close:pointerover Path">
          <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="Button.titlebar-btn-close:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="#C50F1F" />
        </Style>

        <Style Selector="Button.sidebar-ghost">
          <Setter Property="Background" Value="{DynamicResource AppGhostButtonBackground}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Padding" Value="10,8" />
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="Button.sidebar-ghost:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppGhostButtonHover}" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Button.sidebar-rail">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.sidebar-rail:pointerover">
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.sidebar-rail:pressed">
          <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>
        <Style Selector="Button.sidebar-rail:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarHover}" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.sidebar-rail:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Border.sidebar-row">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style Selector="Button.accent">
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.accent TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.accent Path">
          <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppControlHover}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Border.sidebar-host">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="CubicEaseInOut" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="Border.page-host">
          <Setter Property="RenderTransformOrigin" Value="50%,0%" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="Border.login-overlay">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Border.login-card">
          <Setter Property="Opacity" Value="1" />
          <Style.Animations>
            <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Forward">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>

        <!-- Nav: no BrushTransition (avoids light flash); no translate jump on collapse -->
        <Style Selector="ListBox.nav">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
          <Setter Property="Padding" Value="10,10" />
          <Setter Property="Margin" Value="0,2" />
          <Setter Property="MinHeight" Value="40" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover">
          <Setter Property="Background" Value="{DynamicResource AppSidebarHover}" />
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected:pointerover">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
        </Style>
        <Style Selector="ListBox.nav.collapsed ListBoxItem">
          <Setter Property="Padding" Value="10,10" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="ListBox.nav TextBlock.nav-title">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="ListBox.nav.collapsed TextBlock.nav-title">
          <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- Kill Fluent template highlight that flashes light fill -->
        <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected Path.app-icon">
          <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover Path.app-icon">
          <Setter Property="Stroke" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected:pointerover Path.app-icon">
          <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="ListBox.accent-picker">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.accent-picker ListBoxItem">
          <Setter Property="Padding" Value="2" />
          <Setter Property="Margin" Value="0,0,8,8" />
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.accent-picker ListBoxItem:selected /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.accent-picker ListBoxItem:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.accent-swatch">
          <Setter Property="Width" Value="28" />
          <Setter Property="Height" Value="28" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="RenderTransformOrigin" Value="50%,50%" />
          <Setter Property="RenderTransform" Value="none" />
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
              <ThicknessTransition Property="BorderThickness" Duration="0:0:0.16" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Border.accent-swatch:pointerover">
          <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>
        <Style Selector="Border.accent-swatch.selected">
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="RenderTransform" Value="scale(1.12)" />
        </Style>

        <Style Selector="Border.app-card">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.app-panel">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.app-panel-header">
          <Setter Property="Padding" Value="14,12" />
          <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style Selector="TextBlock.page-title">
          <Setter Property="FontSize" Value="26" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="LetterSpacing" Value="-0.3" />
          <Setter Property="Opacity" Value="1" />
          <Style.Animations>
            <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Forward">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="TextBlock.page-subtitle">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
        </Style>
        <Style Selector="TextBlock.section-title">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
    </Application.Styles>
</Application>
