            <SolidColorBrush x:Key="AppGhostButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="AppGhostButtonHover" Color="#55555B" />
            <SolidColorBrush x:Key="AppUserChipBackground" Color="#4A4A50" />
