<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LabelPrint.UI.App"
             xmlns:local="using:LabelPrint.UI"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
      <ResourceDictionary>
        <!-- Accent lives outside ThemeDictionaries so runtime updates are not overwritten -->
        <SolidColorBrush x:Key="AppAccentBrush" Color="#10A37F" />

        <!-- CheckBox: accent on glyph, not box fill (Fluent uses Fill for both fill and border when checked) -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="Transparent" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="AppAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="AppAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="AppAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="AppAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="AppAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="AppAccentBrush" />

        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppSidebarBackground" Color="#171717" />
            <SolidColorBrush x:Key="AppSidebarBorder" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppSidebarHover" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppSidebarSelected" Color="#2F2F2F" />
            <SolidColorBrush x:Key="AppContentBackground" Color="#212121" />
            <SolidColorBrush x:Key="AppSurfaceBackground" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppSurfaceElevated" Color="#303030" />
            <SolidColorBrush x:Key="AppMutedForeground" Color="#9B9B9B" />
            <SolidColorBrush x:Key="AppPrimaryForeground" Color="#ECECEC" />
            <SolidColorBrush x:Key="AppGhostButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="AppGhostButtonHover" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppUserChipBackground" Color="#212121" />
            <SolidColorBrush x:Key="AppControlBackground" Color="#2F2F2F" />
            <SolidColorBrush x:Key="AppControlBorder" Color="#3A3A3A" />
            <SolidColorBrush x:Key="AppControlHover" Color="#3A3A3A" />
            <SolidColorBrush x:Key="AppOverlayScrim" Color="#99000000" />

            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#10A37F" />
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#10A37F" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#10A37F" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#10A37F" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#2F2F2F" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#333333" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2F2F2F" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#6B6B6B" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#ECECEC" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#2F2F2F" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#333333" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2F2F2F" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#ECECEC" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2A2A2A" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3A3A3A" />

            <!-- Fluent accent buttons: neutral chrome, accent content -->
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="AppControlBackground" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AppControlHover" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AppSidebarSelected" />
            <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="AppControlBorder" />
            <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="AppControlBorder" />
            <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="AppControlBorder" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="AppAccentBrush" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppSidebarBackground" Color="#F7F7F8" />
            <SolidColorBrush x:Key="AppSidebarBorder" Color="#E5E5E5" />
            <SolidColorBrush x:Key="AppSidebarHover" Color="#EBEBEB" />
            <SolidColorBrush x:Key="AppSidebarSelected" Color="#E3E3E3" />
            <SolidColorBrush x:Key="AppContentBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceBackground" Color="#F4F4F5" />
            <SolidColorBrush x:Key="AppSurfaceElevated" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppMutedForeground" Color="#6B6B6B" />
            <SolidColorBrush x:Key="AppPrimaryForeground" Color="#0D0D0D" />
            <SolidColorBrush x:Key="AppGhostButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="AppGhostButtonHover" Color="#EBEBEB" />
            <SolidColorBrush x:Key="AppUserChipBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppControlBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppControlBorder" Color="#E5E5E5" />
            <SolidColorBrush x:Key="AppControlHover" Color="#F0F0F0" />
            <SolidColorBrush x:Key="AppOverlayScrim" Color="#66000000" />

            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#10A37F" />
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#10A37F" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#10A37F" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#10A37F" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FAFAFA" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B0B0B0" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#0D0D0D" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FAFAFA" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#0D0D0D" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E5E5E5" />

            <!-- Fluent accent buttons: neutral chrome, accent content -->
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="AppControlBackground" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AppControlHover" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AppSidebarSelected" />
            <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="AppControlBorder" />
            <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="AppControlBorder" />
            <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="AppControlBorder" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="AppAccentBrush" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
          <FluentTheme.Palettes>
            <ColorPaletteResources x:Key="Dark" Accent="#10A37F" />
            <ColorPaletteResources x:Key="Light" Accent="#10A37F" />
          </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector=":is(Control)">
          <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <!-- Global controls: ChatGPT / Claude soft chrome -->
        <Style Selector="Button">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="RenderTransformOrigin" Value="50%,50%" />
          <Setter Property="RenderTransform" Value="none" />
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
              <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Button:pointerover">
          <Setter Property="RenderTransform" Value="scale(1.015)" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppControlHover}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button:pressed">
          <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TextBox">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="SelectionBrush" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="CaretBrush" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{DynamicResource AppMutedForeground}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="TextBox:focus">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="ComboBox">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="Padding" Value="10,6" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
          <Setter Property="BorderBrush" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
        </Style>
        <Style Selector="ComboBox:focus">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="NumericUpDown">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="NumericUpDown:focus">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="CalendarDatePicker">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="TimePicker">
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="MinHeight" Value="38" />
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="CheckBox">
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- Checked: Fluent sets BorderBrush from the fill brush — restore accent stroke on the box -->
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:indeterminate /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:indeterminate:pointerover /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="CheckBox:indeterminate:pressed /template/ Border#NormalRectangle">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="TabControl">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="Margin" Value="0,0,4,0" />
          <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="DataGrid">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="12" />
          <Setter Property="GridLinesVisibility" Value="Horizontal" />
          <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="RowBackground" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="DataGrid.app-grid">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridColumnHeader">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Padding" Value="12,10" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridRow">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
          <Setter Property="Fill" Value="{DynamicResource AppSidebarHover}" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
          <Setter Property="Fill" Value="{DynamicResource AppSidebarSelected}" />
        </Style>
        <Style Selector="DataGrid.app-grid DataGridCell">
          <Setter Property="Padding" Value="10,8" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ScrollViewer">
          <Setter Property="AllowAutoHide" Value="True" />
        </Style>

        <Style Selector="Path.app-icon">
          <Setter Property="Width" Value="16" />
          <Setter Property="Height" Value="16" />
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="Stroke" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="StrokeThickness" Value="1.6" />
          <Setter Property="StrokeLineCap" Value="Round" />
          <Setter Property="StrokeJoin" Value="Round" />
          <Setter Property="Fill" Value="Transparent" />
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Stroke" Duration="0:0:0.15" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Path.app-icon-sm">
          <Setter Property="Width" Value="14" />
          <Setter Property="Height" Value="14" />
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="Stroke" Value="{DynamicResource AppMutedForeground}" />
          <Setter Property="StrokeThickness" Value="1.5" />
          <Setter Property="StrokeLineCap" Value="Round" />
          <Setter Property="StrokeJoin" Value="Round" />
          <Setter Property="Fill" Value="Transparent" />
        </Style>

        <Style Selector="Button.sidebar-ghost">
          <Setter Property="Background" Value="{DynamicResource AppGhostButtonBackground}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Padding" Value="10,8" />
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="Button.sidebar-ghost:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppGhostButtonHover}" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Button.sidebar-rail">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.sidebar-rail:pointerover">
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.sidebar-rail:pressed">
          <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>
        <Style Selector="Button.sidebar-rail:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarHover}" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.sidebar-rail:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Border.sidebar-row">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style Selector="Button.accent">
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppControlBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.accent TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.accent Path">
          <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppControlHover}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Border.sidebar-host">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="CubicEaseInOut" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="Border.page-host">
          <Setter Property="RenderTransformOrigin" Value="50%,0%" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="Border.login-overlay">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Border.login-card">
          <Setter Property="Opacity" Value="1" />
          <Style.Animations>
            <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Forward">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>

        <!-- Nav: no BrushTransition (avoids light flash); no translate jump on collapse -->
        <Style Selector="ListBox.nav">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
          <Setter Property="Padding" Value="10,10" />
          <Setter Property="Margin" Value="0,2" />
          <Setter Property="MinHeight" Value="40" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover">
          <Setter Property="Background" Value="{DynamicResource AppSidebarHover}" />
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected:pointerover">
          <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}" />
        </Style>
        <Style Selector="ListBox.nav.collapsed ListBoxItem">
          <Setter Property="Padding" Value="10,10" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="ListBox.nav TextBlock.nav-title">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="ListBox.nav.collapsed TextBlock.nav-title">
          <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- Kill Fluent template highlight that flashes light fill -->
        <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pressed /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected Path.app-icon">
          <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover Path.app-icon">
          <Setter Property="Stroke" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected:pointerover Path.app-icon">
          <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="ListBox.accent-picker">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.accent-picker ListBoxItem">
          <Setter Property="Padding" Value="2" />
          <Setter Property="Margin" Value="0,0,8,8" />
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.accent-picker ListBoxItem:selected /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.accent-picker ListBoxItem:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.accent-swatch">
          <Setter Property="Width" Value="28" />
          <Setter Property="Height" Value="28" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="RenderTransformOrigin" Value="50%,50%" />
          <Setter Property="RenderTransform" Value="none" />
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
              <ThicknessTransition Property="BorderThickness" Duration="0:0:0.16" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="Border.accent-swatch:pointerover">
          <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>
        <Style Selector="Border.accent-swatch.selected">
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="RenderTransform" Value="scale(1.12)" />
        </Style>

        <Style Selector="Border.app-card">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.app-panel">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.app-panel-header">
          <Setter Property="Padding" Value="14,12" />
          <Setter Property="Background" Value="{DynamicResource AppSurfaceElevated}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarBorder}" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style Selector="TextBlock.page-title">
          <Setter Property="FontSize" Value="26" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
          <Setter Property="LetterSpacing" Value="-0.3" />
          <Setter Property="Opacity" Value="1" />
          <Style.Animations>
            <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Forward">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="TextBlock.page-subtitle">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
        </Style>
        <Style Selector="TextBlock.section-title">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        </Style>
    </Application.Styles>
</Application>
